# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/
.internal/

# React/Node.js Frontend (fe/)
fe/node_modules/
fe/dist/
fe/build/
fe/.vite/
fe/.cache/

# Node.js
fe/package-lock.json
fe/yarn.lock
fe/pnpm-lock.yaml

# Environment files
fe/.env
fe/.env.local
fe/.env.development.local
fe/.env.test.local
fe/.env.production.local

# Logs
fe/npm-debug.log*
fe/yarn-debug.log*
fe/yarn-error.log*
fe/lerna-debug.log*

# Runtime data
fe/pids
fe/*.pid
fe/*.seed
fe/*.pid.lock

# Coverage directory used by tools like istanbul
fe/coverage/
fe/.nyc_output

# ESLint cache
fe/.eslintcache

# Optional npm cache directory
fe/.npm

# Optional REPL history
fe/.node_repl_history

# Output of 'npm pack'
fe/*.tgz

# Yarn Integrity file
fe/.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
fe/.cache
fe/.parcel-cache

# Next.js build output
fe/.next

# Nuxt.js build / generate output
fe/.nuxt
fe/dist

# Storybook build outputs
fe/.out
fe/.storybook-out

# Temporary folders
fe/tmp/
fe/temp/